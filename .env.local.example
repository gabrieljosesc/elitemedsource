# Supabase (Project → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact details shown in the header, footer, contact page, and emails.
# Phone / fax are hidden while empty.
NEXT_PUBLIC_CONTACT_EMAIL=info@elitemedsource.com
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_FAX=

# Checkout — encrypts card-on-file details for manual/admin processing
# (no live charge is ever run). Any long random string works; changing it
# invalidates previously-stored card snapshots.
PAYMENT_CARD_SECRET=

# Email — SMTP first (your mail host), Resend as a fallback.
# Order/status emails silently no-op while neither is configured.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=
EMAIL_FROM=Elite MedSource <info@elitemedsource.com>
NOTIFICATION_EMAIL=
ADMIN_NOTIFY_EMAILS=

# Optional — Google Places address autocomplete on checkout
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
